{
  "rules": {
    ".read": false,
    ".write": false,

    "users": {
      ".read": "auth != null",
      ".indexOn": ["nameLower", "usernameLower", "createdAt", "online"],
      "$uid": {
        ".write": "auth != null && auth.uid == $uid"
      }
    },

    "usernames": {
      ".read": "auth != null",
      "$name": {
        ".write": "auth != null && (!data.exists() || data.val() == auth.uid)",
        ".validate": "newData.val() == auth.uid"
      }
    },

    "friendRequests": {
      "$to": {
        ".read": "auth != null && auth.uid == $to",
        "$from": {
          ".read": "auth != null && auth.uid == $from",
          ".write": "auth != null && (auth.uid == $to || auth.uid == $from)"
        }
      }
    },

    "friends": {
      "$uid": {
        ".read": "auth != null",
        "$fid": {
          ".write": "auth != null && (auth.uid == $uid || auth.uid == $fid) && (!newData.exists() || data.exists() || root.child('friendRequests').child(auth.uid).child(auth.uid == $uid ? $fid : $uid).exists())"
        }
      }
    },

    "closeFriends": {
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        "$fid": {
          ".read": "auth != null && auth.uid == $fid",
          ".write": "auth != null && (auth.uid == $uid || (auth.uid == $fid && !newData.exists()))"
        }
      }
    },

    "posts": {
      ".read": "auth != null",
      ".indexOn": ["authorId", "timestamp"],
      "$pid": {
        ".write": "auth != null && (data.exists() ? data.child('authorId').val() == auth.uid : newData.child('authorId').val() == auth.uid)",
        "reactions": {
          "$uid": { ".write": "auth != null && auth.uid == $uid" }
        },
        "commentCount": { ".write": "auth != null && data.parent().exists()" },
        "shareCount": { ".write": "auth != null && data.parent().exists()" }
      }
    },

    "comments": {
      "$pid": {
        ".read": "auth != null",
        ".write": "auth != null && root.child('posts').child($pid).child('authorId').val() == auth.uid",
        "$cid": {
          ".write": "auth != null && (data.exists() ? data.child('authorId').val() == auth.uid : newData.child('authorId').val() == auth.uid)",
          "likes": {
            "$uid": { ".write": "auth != null && auth.uid == $uid" }
          }
        }
      }
    },

    "stories": {
      ".read": "auth != null",
      "$uid": {
        "$sid": {
          ".write": "auth != null && auth.uid == $uid",
          "viewers": {
            "$viewer": { ".write": "auth != null && auth.uid == $viewer" }
          },
          "reactions": {
            "$viewer": { ".write": "auth != null && auth.uid == $viewer" }
          }
        }
      }
    },

    "media": {
      ".read": "auth != null",
      "$mid": {
        ".write": "auth != null && (data.exists() ? data.child('ownerId').val() == auth.uid : newData.child('ownerId').val() == auth.uid)"
      }
    },

    "notifications": {
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        ".indexOn": ["timestamp", "read"],
        "$nid": {
          ".write": "auth != null && (auth.uid == $uid || (!data.exists() && newData.child('fromUid').val() == auth.uid))"
        }
      }
    },

    "userChats": {
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        ".indexOn": ["timestamp"],
        "$chatId": {
          ".write": "auth != null && $chatId.contains(auth.uid)"
        }
      }
    },

    "messages": {
      "$chatId": {
        ".read": "auth != null && $chatId.contains(auth.uid)",
        "$mid": {
          ".write": "auth != null && $chatId.contains(auth.uid) && (data.exists() ? (data.child('senderId').val() == auth.uid && now - data.child('timestamp').val() <= 300000) : newData.child('senderId').val() == auth.uid)",
          "reactions": {
            "$uid": { ".write": "auth != null && auth.uid == $uid && $chatId.contains(auth.uid)" }
          }
        }
      }
    },

    "typing": {
      "$chatId": {
        ".read": "auth != null && $chatId.contains(auth.uid)",
        "$uid": { ".write": "auth != null && auth.uid == $uid && $chatId.contains(auth.uid)" }
      }
    },

    "chatReads": {
      "$chatId": {
        ".read": "auth != null && $chatId.contains(auth.uid)",
        "$uid": { ".write": "auth != null && auth.uid == $uid && $chatId.contains(auth.uid)" }
      }
    },

    "calls": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && (auth.uid == $uid || !data.exists() || data.child('callerId').val() == auth.uid || now - data.child('timestamp').val() > 120000)"
      }
    },

    "callLogs": {
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        ".write": "auth != null && auth.uid == $uid"
      }
    },

    "listings": {
      ".read": "auth != null",
      ".indexOn": ["timestamp"],
      "$lid": {
        ".write": "auth != null && !data.exists()"
      }
    }
  }
}