<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <!-- ===== Toolbar: back arrow, "Comments", "Most relevant" pill ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/toolbar_height"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/iv_back"
            style="@style/Kinnect.IconButton"
            android:contentDescription="@string/cd_back"
            android:src="@drawable/ic_back" />

        <TextView
            android:id="@+id/tv_comments_title"
            style="@style/Kinnect.Text.Title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:singleLine="true"
            android:text="@string/comments_title" />

        <!-- Sort pill: switches between Most relevant (most liked first) and Newest -->
        <LinearLayout
            android:id="@+id/ll_sort"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/chip_height"
            android:layout_marginEnd="@dimen/screen_margin"
            android:background="@drawable/bg_chip"
            android:contentDescription="@string/cd_sort_comments"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/chip_padding"
            android:paddingEnd="@dimen/chip_padding_end">

            <TextView
                android:id="@+id/tv_sort"
                style="@style/Kinnect.Text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/figtree_bold"
                android:singleLine="true"
                android:text="@string/comments_most_relevant"
                android:textSize="@dimen/text_caption" />

            <ImageView
                android:layout_width="@dimen/icon_size_chevron"
                android:layout_height="@dimen/icon_size_chevron"
                android:layout_marginStart="@dimen/sort_chevron_gap"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_chevron_down"
                app:tint="@color/text_dark" />
        </LinearLayout>
    </LinearLayout>

    <View style="@style/Kinnect.Divider" />

    <!-- ===== Reaction summary of the post: up to three reaction kinds, the total, chevron.
         Tapping it opens the Reaction picker. Hidden while nobody has reacted. ===== -->
    <LinearLayout
        android:id="@+id/ll_summary"
        android:layout_width="match_parent"
        android:layout_height="@dimen/summary_row_height"
        android:background="?attr/selectableItemBackground"
        android:contentDescription="@string/cd_reactions"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/screen_margin"
        android:paddingEnd="@dimen/screen_margin"
        android:paddingBottom="@dimen/reaction_row_padding_bottom">

        <!-- White disc behind each icon = ring; negative margin = overlap (as on Home) -->
        <ImageView
            android:id="@+id/iv_summary_1"
            android:layout_width="@dimen/reaction_size_small"
            android:layout_height="@dimen/reaction_size_small"
            android:background="@drawable/bg_avatar_circle"
            android:importantForAccessibility="no"
            android:padding="@dimen/reaction_ring" />

        <ImageView
            android:id="@+id/iv_summary_2"
            android:layout_width="@dimen/reaction_size_small"
            android:layout_height="@dimen/reaction_size_small"
            android:layout_marginStart="@dimen/reaction_overlap"
            android:background="@drawable/bg_avatar_circle"
            android:importantForAccessibility="no"
            android:padding="@dimen/reaction_ring" />

        <ImageView
            android:id="@+id/iv_summary_3"
            android:layout_width="@dimen/reaction_size_small"
            android:layout_height="@dimen/reaction_size_small"
            android:layout_marginStart="@dimen/reaction_overlap"
            android:background="@drawable/bg_avatar_circle"
            android:importantForAccessibility="no"
            android:padding="@dimen/reaction_ring" />

        <TextView
            android:id="@+id/tv_summary_total"
            style="@style/Kinnect.Text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/summary_text_gap"
            android:layout_weight="1" />

        <ImageView
            android:layout_width="@dimen/icon_size_chevron"
            android:layout_height="@dimen/icon_size_chevron"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_chevron_right"
            app:tint="@color/text_dark" />
    </LinearLayout>

    <View style="@style/Kinnect.Divider" />

    <!-- ===== Comment list: item_comment.xml (comments and replies) and
         item_comment_more.xml ("View 3 more replies"), filled by CommentsActivity.
         clipChildren="false" lets a reply's thread line reach up into the row above. ===== -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_comments"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:paddingTop="@dimen/comments_list_top"
            android:paddingBottom="@dimen/space_16" />

        <TextView
            android:id="@+id/tv_empty"
            style="@style/Kinnect.Text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_32"
            android:gravity="center_horizontal"
            android:padding="@dimen/space_16"
            android:text="@string/comments_empty"
            android:textColor="@color/text_grey"
            android:visibility="gone" />
    </FrameLayout>

    <!-- ===== Reply bar (pinned) ===== -->
    <View style="@style/Kinnect.Divider" />

    <!-- "Replying to Aisha Khan" ... "Cancel": only while replying to a comment -->
    <LinearLayout
        android:id="@+id/ll_replying"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="@dimen/reply_banner_height"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/screen_margin"
        android:paddingEnd="@dimen/reply_cancel_end">

        <TextView
            style="@style/Kinnect.Text.CommentMeta"
            android:singleLine="true"
            android:text="@string/reply_replying_to"
            android:textSize="@dimen/text_subtitle" />

        <TextView
            android:id="@+id/tv_replying_name"
            style="@style/Kinnect.Text.CommentName"
            android:layout_width="0dp"
            android:layout_marginStart="@dimen/space_4"
            android:layout_weight="1"
            android:ellipsize="end"
            android:singleLine="true"
            android:textColor="@color/text_dark"
            android:textSize="@dimen/text_subtitle" />

        <TextView
            android:id="@+id/tv_cancel_reply"
            style="@style/Kinnect.Text.CommentMeta"
            android:fontFamily="@font/figtree_bold"
            android:text="@string/reply_cancel"
            android:textSize="@dimen/text_subtitle" />
    </LinearLayout>

    <!-- The photo chosen with the camera button, with an X to remove it -->
    <FrameLayout
        android:id="@+id/fl_attached"
        android:layout_width="@dimen/picked_photo_size"
        android:layout_height="@dimen/picked_photo_size"
        android:layout_marginStart="@dimen/screen_margin"
        android:layout_marginTop="@dimen/space_8"
        android:layout_marginBottom="@dimen/space_8"
        android:visibility="gone">

        <ImageView
            android:id="@+id/iv_attached"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_gallery_thumb"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop" />

        <ImageView
            android:id="@+id/iv_remove_attached"
            android:layout_width="@dimen/picked_remove_touch"
            android:layout_height="@dimen/picked_remove_touch"
            android:layout_gravity="top|end"
            android:background="@drawable/bg_picked_remove"
            android:contentDescription="@string/cd_remove_comment_photo"
            android:padding="@dimen/picked_remove_padding"
            android:src="@drawable/ic_close"
            app:tint="@color/white" />
    </FrameLayout>

    <!-- Camera (adds a photo), "Write a comment..." pill with an emoji icon, teal send circle.
         The camera and the pill are 48dp touch targets around 37dp visuals: the row reaches
         5.5dp up (negative margin + equal padding) so both fit inside it without moving. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/reply_camera_overlap"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingTop="@dimen/reply_bar_touch_top"
        android:paddingBottom="@dimen/reply_bar_bottom">

        <ImageView
            android:id="@+id/iv_reply_camera"
            style="@style/Kinnect.IconButton"
            android:layout_marginStart="@dimen/reply_camera_start"
            android:layout_marginTop="@dimen/reply_camera_overlap"
            android:layout_marginBottom="@dimen/reply_camera_overlap"
            android:contentDescription="@string/cd_add_photo_reply"
            android:padding="@dimen/reply_camera_padding"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_camera"
            app:tint="@color/teal" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="@dimen/touch_target"
            android:layout_marginTop="@dimen/reply_camera_overlap"
            android:layout_marginBottom="@dimen/reply_camera_overlap"
            android:layout_weight="1"
            android:background="@drawable/bg_touch_chip_37"
            android:paddingTop="0dp"
            android:paddingBottom="0dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/reply_field_padding_start"
            android:paddingEnd="@dimen/reply_smile_end">

            <EditText
                android:id="@+id/et_reply"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@null"
                android:fontFamily="@font/figtree_regular"
                android:hint="@string/comment_hint"
                android:importantForAutofill="no"
                android:inputType="textCapSentences"
                android:padding="0dp"
                android:singleLine="true"
                android:textColor="@color/text_dark"
                android:textColorHint="@color/text_hint"
                android:textSize="@dimen/text_body" />

            <ImageView
                android:layout_width="@dimen/reply_smile_size"
                android:layout_height="@dimen/reply_smile_size"
                android:contentDescription="@string/cd_emoji"
                android:src="@drawable/ic_smile"
                app:tint="@color/text_grey" />
        </LinearLayout>

        <ImageView
            android:id="@+id/iv_send"
            android:layout_width="@dimen/circle_button"
            android:layout_height="@dimen/circle_button"
            android:layout_marginStart="@dimen/reply_send_gap"
            android:layout_marginEnd="@dimen/reply_send_end"
            android:background="@drawable/bg_circle_teal"
            android:contentDescription="@string/cd_send"
            android:padding="@dimen/reply_send_padding"
            android:src="@drawable/ic_send"
            app:tint="@color/white" />
    </LinearLayout>
</LinearLayout>