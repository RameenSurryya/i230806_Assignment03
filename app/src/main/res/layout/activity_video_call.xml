<?xml version="1.0" encoding="utf-8"?>
<!-- Video call: their camera fills the screen, mine sits small in the top-right corner.
     Until their video arrives, their avatar, name and "Calling..." show in the middle.
     Same buttons and colours as the voice call (22). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/camera_bg"
    android:fitsSystemWindows="true">

    <!-- Their camera (AgoraCall puts a SurfaceView in here) -->
    <FrameLayout
        android:id="@+id/fl_remote_video"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@string/cd_their_video" />

    <!-- Avatar (hidden once their video shows), name and status / timer -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/video_waiting_top"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <FrameLayout
            android:id="@+id/fl_call_avatar"
            android:layout_width="@dimen/avatar_144"
            android:layout_height="@dimen/avatar_144">

            <TextView
                android:id="@+id/tv_call_avatar"
                style="@style/Kinnect.Avatar"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_call_avatar"
                android:textSize="@dimen/text_avatar_144" />

            <ImageView
                android:id="@+id/iv_call_avatar_photo"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_call_avatar"
                android:importantForAccessibility="no"
                android:scaleType="centerCrop"
                android:visibility="gone" />
        </FrameLayout>

        <TextView
            android:id="@+id/tv_call_name"
            style="@style/Kinnect.Text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/call_name_top"
            android:fontFamily="@font/bricolage_grotesque_extrabold"
            android:includeFontPadding="false"
            android:shadowColor="@color/camera_bg"
            android:shadowRadius="6"
            android:textColor="@color/white"
            android:textSize="@dimen/text_call_name" />

        <TextView
            android:id="@+id/tv_call_status"
            style="@style/Kinnect.Text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/call_timer_top"
            android:includeFontPadding="false"
            android:shadowColor="@color/camera_bg"
            android:shadowRadius="6"
            android:textColor="@color/text_on_teal_soft"
            android:textSize="@dimen/text_call_timer" />
    </LinearLayout>

    <!-- My camera: small rounded frame in the top-right corner -->
    <FrameLayout
        android:id="@+id/fl_local_video"
        android:layout_width="@dimen/video_local_width"
        android:layout_height="@dimen/video_local_height"
        android:layout_gravity="top|end"
        android:layout_margin="@dimen/video_local_margin"
        android:background="@drawable/bg_video_local"
        android:contentDescription="@string/cd_your_video" />

    <!-- Controls: flip camera, camera on / off, mute, end -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginBottom="@dimen/call_controls_bottom"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/iv_flip"
            style="@style/Kinnect.CallControl"
            android:contentDescription="@string/cd_flip_camera"
            android:src="@drawable/ic_flip" />

        <ImageView
            android:id="@+id/iv_camera"
            style="@style/Kinnect.CallControl"
            android:layout_marginStart="@dimen/call_control_gap"
            android:contentDescription="@string/cd_camera_off"
            android:src="@drawable/ic_video" />

        <ImageView
            android:id="@+id/iv_mute"
            style="@style/Kinnect.CallControl"
            android:layout_marginStart="@dimen/call_control_gap"
            android:contentDescription="@string/cd_mute"
            android:src="@drawable/ic_mic" />

        <ImageView
            android:id="@+id/iv_end_call"
            style="@style/Kinnect.CallControl"
            android:layout_width="@dimen/call_end"
            android:layout_height="@dimen/call_end"
            android:layout_marginStart="@dimen/call_control_gap"
            android:background="@drawable/bg_call_end"
            android:contentDescription="@string/cd_end_call"
            android:padding="@dimen/call_end_padding"
            android:src="@drawable/ic_call_end" />
    </LinearLayout>
</FrameLayout>