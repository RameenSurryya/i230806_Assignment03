<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface"
    android:fitsSystemWindows="true"
    android:focusableInTouchMode="true"
    android:orientation="vertical">

    <!-- ===== Top row: back arrow + search field ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/search_bar_height"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/iv_back"
            style="@style/Kinnect.IconButton"
            android:contentDescription="@string/cd_back"
            android:src="@drawable/ic_back" />

        <!-- Grey pill (37dp, drawn inside a 48dp touch target): magnifier, the typed text and the round clear button -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="@dimen/touch_target"
            android:layout_marginStart="@dimen/search_field_start"
            android:layout_marginEnd="@dimen/screen_margin"
            android:layout_weight="1"
            android:background="@drawable/bg_touch_chip_37"
            android:paddingTop="0dp"
            android:paddingBottom="0dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/search_field_padding"
            android:paddingEnd="@dimen/search_clear_end">

            <ImageView
                android:layout_width="@dimen/icon_size_small"
                android:layout_height="@dimen/icon_size_small"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_search"
                app:tint="@color/text_grey" />

            <EditText
                android:id="@+id/et_search"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="@dimen/search_text_start"
                android:layout_weight="1"
                android:background="@null"
                android:fontFamily="@font/figtree_regular"
                android:hint="@string/search_hint"
                android:imeOptions="actionSearch"
                android:importantForAutofill="no"
                android:inputType="text"
                android:padding="0dp"
                android:singleLine="true"
                android:textColor="@color/text_dark"
                android:textColorHint="@color/text_hint"
                android:textSize="@dimen/text_body" />

            <!-- Clear button: empties the field (hidden while it is empty). Grey circle (bg_circle_grey re-tinted) with a white X. -->
            <ImageView
                android:id="@+id/iv_clear"
                android:layout_width="@dimen/search_clear"
                android:layout_height="@dimen/search_clear"
                android:background="@drawable/bg_circle_grey"
                android:backgroundTint="@color/search_clear"
                android:contentDescription="@string/cd_clear_search"
                android:padding="@dimen/search_clear_padding"
                android:src="@drawable/ic_close"
                android:visibility="gone"
                app:tint="@color/white" />
        </LinearLayout>
    </LinearLayout>

    <!-- ===== Filter chips: "All" selected (visual only: Search finds people). The row scrolls
         sideways; Marketplace runs off the edge. ===== -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/search_chips_top"
        android:layout_marginBottom="@dimen/search_chips_bottom"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="@dimen/screen_margin"
            android:paddingEnd="@dimen/screen_margin">

            <TextView
                style="@style/Kinnect.Chip.Selected"
                android:layout_height="@dimen/chip_height_small"
                android:text="@string/search_all" />

            <TextView
                style="@style/Kinnect.Chip"
                android:layout_height="@dimen/chip_height_small"
                android:layout_marginStart="@dimen/chip_gap"
                android:text="@string/search_people" />

            <TextView
                style="@style/Kinnect.Chip"
                android:layout_height="@dimen/chip_height_small"
                android:layout_marginStart="@dimen/chip_gap"
                android:text="@string/search_posts" />

            <TextView
                style="@style/Kinnect.Chip"
                android:layout_height="@dimen/chip_height_small"
                android:layout_marginStart="@dimen/chip_gap"
                android:text="@string/search_groups" />

            <TextView
                style="@style/Kinnect.Chip"
                android:layout_height="@dimen/chip_height_small"
                android:layout_marginStart="@dimen/chip_gap"
                android:text="@string/search_marketplace" />
        </LinearLayout>
    </HorizontalScrollView>

    <View style="@style/Kinnect.Divider" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- ===== While typing: People found (RecyclerView, item_search_person.xml) ===== -->
        <LinearLayout
            android:id="@+id/ll_results"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                style="@style/Kinnect.Text.SectionTitle.Small"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/screen_margin"
                android:layout_marginTop="@dimen/search_title_top"
                android:includeFontPadding="false"
                android:text="@string/search_people" />

            <TextView
                android:id="@+id/tv_no_results"
                style="@style/Kinnect.Text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/screen_margin"
                android:layout_marginTop="@dimen/space_16"
                android:layout_marginEnd="@dimen/screen_margin"
                android:textColor="@color/text_grey"
                android:visibility="gone" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_people"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="@dimen/search_rows_top"
                android:layout_weight="1"
                android:clipToPadding="false"
                android:paddingBottom="@dimen/space_16" />
        </LinearLayout>

        <!-- ===== Empty field: Recent searches, saved on this phone (item_recent_search.xml) ===== -->
        <ScrollView
            android:id="@+id/sv_recent"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="@dimen/space_16">

                <TextView
                    style="@style/Kinnect.Text.SectionTitle.Small"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/screen_margin"
                    android:layout_marginTop="@dimen/search_title_top"
                    android:includeFontPadding="false"
                    android:text="@string/search_recent" />

                <TextView
                    android:id="@+id/tv_no_recent"
                    style="@style/Kinnect.Text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/screen_margin"
                    android:layout_marginTop="@dimen/space_16"
                    android:layout_marginEnd="@dimen/screen_margin"
                    android:text="@string/search_no_recent"
                    android:textColor="@color/text_grey" />

                <!-- One row per recent search, added by SearchActivity -->
                <LinearLayout
                    android:id="@+id/ll_recent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/search_recent_rows_top"
                    android:orientation="vertical" />
            </LinearLayout>
        </ScrollView>
    </FrameLayout>
</LinearLayout>