<?xml version="1.0" encoding="utf-8"?>
<!-- Incoming call (not in the design; same look as the voice call 22): the caller's avatar in
     the two soft rings, their name, "Incoming voice call", then Decline (red) and Answer (green). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/teal"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <!-- Avatar in two soft rings -->
            <FrameLayout
                android:layout_width="@dimen/call_halo_outer_size"
                android:layout_height="@dimen/call_halo_outer_size"
                android:layout_marginTop="@dimen/call_halo_top"
                android:background="@drawable/bg_call_halo_outer"
                android:padding="@dimen/call_halo_outer_width">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_call_halo_inner"
                    android:padding="@dimen/call_halo_inner_width">

                    <TextView
                        android:id="@+id/tv_call_avatar"
                        style="@style/Kinnect.Avatar"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_call_avatar"
                        android:textSize="@dimen/text_avatar_144" />

                    <ImageView
                        android:id="@+id/iv_call_avatar_photo"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_call_avatar"
                        android:importantForAccessibility="no"
                        android:scaleType="centerCrop"
                        android:visibility="gone" />
                </FrameLayout>
            </FrameLayout>

            <TextView
                android:id="@+id/tv_call_name"
                style="@style/Kinnect.Text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/call_name_top"
                android:fontFamily="@font/bricolage_grotesque_extrabold"
                android:includeFontPadding="false"
                android:textColor="@color/white"
                android:textSize="@dimen/text_call_name" />

            <TextView
                android:id="@+id/tv_call_type"
                style="@style/Kinnect.Text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/call_timer_top"
                android:includeFontPadding="false"
                android:textColor="@color/text_on_teal_soft"
                android:textSize="@dimen/text_call_timer" />
        </LinearLayout>
    </ScrollView>

    <!-- Decline and Answer, each with its label underneath -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/call_controls_bottom"
        android:gravity="center"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/iv_decline"
                android:layout_width="@dimen/call_end"
                android:layout_height="@dimen/call_end"
                android:background="@drawable/bg_call_end"
                android:contentDescription="@string/cd_decline_call"
                android:padding="@dimen/call_end_padding"
                android:src="@drawable/ic_call_end"
                app:tint="@color/white" />

            <TextView
                style="@style/Kinnect.Text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/incoming_label_top"
                android:importantForAccessibility="no"
                android:text="@string/cd_decline_call"
                android:textColor="@color/white" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/incoming_buttons_gap"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <!-- Phone or video icon, set in IncomingCallActivity -->
            <ImageView
                android:id="@+id/iv_answer"
                android:layout_width="@dimen/call_end"
                android:layout_height="@dimen/call_end"
                android:background="@drawable/bg_call_accept"
                android:contentDescription="@string/cd_answer_call"
                android:padding="@dimen/call_end_padding"
                android:src="@drawable/ic_phone"
                app:tint="@color/white" />

            <TextView
                style="@style/Kinnect.Text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/incoming_label_top"
                android:importantForAccessibility="no"
                android:text="@string/cd_answer_call"
                android:textColor="@color/white" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>