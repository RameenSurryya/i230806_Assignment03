<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <!-- Pinned: "kinnect" wordmark + search / messenger (large circles on Home) -->
    <include layout="@layout/include_top_bar" />

    <!-- Pinned: five tabs, Home active (set in HomeActivity) -->
    <include layout="@layout/include_top_tabs" />

    <ScrollView
        android:id="@+id/sv_home"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- ===== Composer row: avatar, "What's on your mind" pill, image icon ===== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/composer_row_height"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="@dimen/screen_margin">

                <!-- Your avatar (opens your profile): the 36dp circle sits in a 48dp touch
                     target; the profile picture is drawn on top when you have one. -->
                <FrameLayout
                    android:id="@+id/fl_composer_avatar"
                    android:layout_width="@dimen/touch_target"
                    android:layout_height="@dimen/touch_target"
                    android:layout_marginStart="@dimen/composer_avatar_overlap"
                    android:layout_marginEnd="@dimen/composer_avatar_overlap"
                    android:contentDescription="@string/cd_your_profile">

                    <TextView
                        android:id="@+id/tv_composer_avatar"
                        style="@style/Kinnect.Avatar"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_touch_avatar_36" />

                    <ImageView
                        android:id="@+id/iv_composer_photo_avatar"
                        android:layout_width="@dimen/avatar_36"
                        android:layout_height="@dimen/avatar_36"
                        android:layout_gravity="center"
                        android:background="@drawable/bg_avatar_circle"
                        android:importantForAccessibility="no"
                        android:scaleType="centerCrop"
                        android:visibility="gone" />
                </FrameLayout>

                <!-- Looks like a text field, but it is a TextView: tapping opens Create post.
                     37dp pill in a 48dp touch target. -->
                <TextView
                    android:id="@+id/tv_composer"
                    style="@style/Kinnect.Text"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/touch_target"
                    android:layout_marginStart="@dimen/composer_avatar_gap"
                    android:layout_weight="1"
                    android:background="@drawable/bg_touch_composer_37"
                    android:ellipsize="end"
                    android:gravity="center_vertical"
                    android:paddingStart="@dimen/composer_pill_padding"
                    android:paddingEnd="@dimen/composer_pill_padding"
                    android:singleLine="true"
                    android:text="@string/create_text_hint"
                    android:textColor="@color/text_grey" />

                <!-- Teal image icon (21dp) in a 48dp touch frame: Create post straight to the picker -->
                <ImageView
                    android:id="@+id/iv_composer_photo"
                    android:layout_width="@dimen/touch_target"
                    android:layout_height="@dimen/touch_target"
                    android:layout_marginStart="@dimen/composer_icon_gap"
                    android:layout_marginEnd="@dimen/composer_icon_end"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/cd_add_photo_post"
                    android:padding="@dimen/composer_icon_padding"
                    android:src="@drawable/ic_image"
                    app:tint="@color/teal" />
            </LinearLayout>

            <View style="@style/Kinnect.SectionBand" />

            <!-- ===== Stories row: "Create story", then one card per person with a story
                 (item_story_card.xml, added by HomeActivity). Scrolls sideways. ===== -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="@dimen/stories_padding"
                android:paddingBottom="@dimen/stories_padding"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/ll_stories"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/screen_margin"
                    android:paddingEnd="@dimen/screen_margin">

                    <!-- Create story: pale teal top half, your big avatar, "+" circle on the
                         boundary, label in the white bottom half (FrameLayout overlaps) -->
                    <FrameLayout
                        android:id="@+id/fl_create_story"
                        android:layout_width="@dimen/story_card_width"
                        android:layout_height="@dimen/story_card_height"
                        android:layout_marginEnd="@dimen/story_card_gap"
                        android:background="@drawable/bg_story_create"
                        android:contentDescription="@string/cd_create_story"
                        android:foreground="?attr/selectableItemBackground">

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/story_create_top_height"
                            android:layout_margin="@dimen/divider"
                            android:background="@drawable/bg_story_create_top" />

                        <TextView
                            android:id="@+id/tv_create_avatar"
                            style="@style/Kinnect.Avatar"
                            android:layout_width="@dimen/avatar_58"
                            android:layout_height="@dimen/avatar_58"
                            android:layout_gravity="center_horizontal"
                            android:layout_marginTop="@dimen/story_create_avatar_top"
                            android:textSize="@dimen/text_avatar_58" />

                        <ImageView
                            android:id="@+id/iv_create_avatar_photo"
                            android:layout_width="@dimen/avatar_58"
                            android:layout_height="@dimen/avatar_58"
                            android:layout_gravity="center_horizontal"
                            android:layout_marginTop="@dimen/story_create_avatar_top"
                            android:background="@drawable/bg_avatar_circle"
                            android:importantForAccessibility="no"
                            android:scaleType="centerCrop"
                            android:visibility="gone" />

                        <ImageView
                            android:layout_width="@dimen/story_plus_size"
                            android:layout_height="@dimen/story_plus_size"
                            android:layout_gravity="center_horizontal"
                            android:layout_marginTop="@dimen/story_plus_top"
                            android:background="@drawable/bg_story_plus"
                            android:importantForAccessibility="no"
                            android:padding="@dimen/story_plus_padding"
                            android:src="@drawable/ic_plus"
                            app:tint="@color/white" />

                        <TextView
                            style="@style/Kinnect.Text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="bottom|center_horizontal"
                            android:layout_marginBottom="@dimen/story_create_label_bottom"
                            android:ellipsize="end"
                            android:fontFamily="@font/figtree_bold"
                            android:maxLines="1"
                            android:text="@string/home_create_story"
                            android:textSize="@dimen/text_small" />
                    </FrameLayout>
                </LinearLayout>
            </HorizontalScrollView>

            <View style="@style/Kinnect.SectionBand" />

            <!-- ===== The feed: one item_post.xml per post, newest first. Its own scrolling
                 is off, so the whole page (composer, stories, posts) scrolls as one. ===== -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_feed"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/tv_feed_empty"
                style="@style/Kinnect.Text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/space_32"
                android:gravity="center_horizontal"
                android:text="@string/feed_empty"
                android:textColor="@color/text_grey"
                android:visibility="gone" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>