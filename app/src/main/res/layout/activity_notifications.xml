<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <!-- Pinned: "Notifications" + small search / messenger circles -->
    <include
        layout="@layout/include_top_bar"
        android:theme="@style/ThemeOverlay.Kinnect.TopBarSmall" />

    <!-- Pinned: five tabs, Notifications active (the bell badge counts the unread ones) -->
    <include layout="@layout/include_top_tabs" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="@dimen/space_16">

            <!-- ===== New: unread notifications on a light teal band (hidden when none) ===== -->
            <TextView
                android:id="@+id/tv_new_title"
                style="@style/Kinnect.Text.SectionTitle.Small"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/screen_margin"
                android:layout_marginTop="@dimen/notif_new_top"
                android:includeFontPadding="false"
                android:text="@string/notif_new" />

            <!-- The rows are item_notification.xml. The list's own scrolling is off:
                 the page scrolls as one. -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_new"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/notif_band_top"
                android:background="@color/teal_tint"
                android:paddingTop="@dimen/notif_band_padding_top"
                android:paddingBottom="@dimen/notif_band_padding_bottom" />

            <!-- ===== Earlier: already seen ===== -->
            <TextView
                android:id="@+id/tv_earlier_title"
                style="@style/Kinnect.Text.SectionTitle.Small"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/screen_margin"
                android:layout_marginTop="@dimen/notif_earlier_top"
                android:includeFontPadding="false"
                android:text="@string/notif_earlier" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_earlier"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/notif_earlier_rows_top" />

            <!-- Nothing at all yet -->
            <TextView
                android:id="@+id/tv_empty"
                style="@style/Kinnect.Text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/screen_margin"
                android:layout_marginTop="@dimen/space_32"
                android:layout_marginEnd="@dimen/screen_margin"
                android:gravity="center_horizontal"
                android:text="@string/notif_empty"
                android:textColor="@color/text_grey"
                android:visibility="gone" />

            <!-- See previous notifications: loads 30 more (shown while there may be older ones) -->
            <Button
                android:id="@+id/btn_see_previous"
                style="@style/Kinnect.Button.Grey"
                android:layout_marginStart="@dimen/screen_margin"
                android:layout_marginTop="@dimen/notif_see_previous_top"
                android:layout_marginEnd="@dimen/screen_margin"
                android:text="@string/notif_see_previous"
                android:visibility="gone" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>