<?xml version="1.0" encoding="utf-8"?>
<!-- One story card in the Home stories row (04): the newest story picture, the person's
     avatar in a ring (teal = something new to watch, white = all seen) and their name on a
     dark strip. HomeActivity adds one per person after the "Create story" card. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="@dimen/story_card_width"
    android:layout_height="@dimen/story_card_height"
    android:layout_marginEnd="@dimen/story_card_gap"
    android:background="@drawable/bg_story_card"
    android:foreground="?attr/selectableItemBackground">

    <ImageView
        android:id="@+id/iv_story_photo"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        android:src="@drawable/ph_night" />

    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/story_scrim_height"
        android:layout_gravity="bottom"
        android:background="@color/story_scrim" />

    <!-- Ring (bg_avatar_ring when unseen), initials disc and photo inside -->
    <FrameLayout
        android:id="@+id/fl_story_ring"
        android:layout_width="@dimen/story_ring_size"
        android:layout_height="@dimen/story_ring_size"
        android:layout_margin="@dimen/story_ring_inset"
        android:background="@drawable/bg_avatar_ring"
        android:padding="@dimen/story_ring_padding">

        <TextView
            android:id="@+id/tv_story_avatar"
            style="@style/Kinnect.Avatar"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:textSize="@dimen/text_avatar_30" />

        <ImageView
            android:id="@+id/iv_story_avatar_photo"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_avatar_circle"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop"
            android:visibility="gone" />
    </FrameLayout>

    <TextView
        android:id="@+id/tv_story_name"
        style="@style/Kinnect.Text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginBottom="@dimen/story_name_bottom"
        android:ellipsize="end"
        android:fontFamily="@font/figtree_semibold"
        android:paddingStart="@dimen/story_name_padding"
        android:paddingEnd="@dimen/story_name_padding"
        android:singleLine="true"
        android:textColor="@color/white"
        android:textSize="@dimen/text_small" />
</FrameLayout>