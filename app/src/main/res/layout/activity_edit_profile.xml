<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface"
    android:fitsSystemWindows="true"
    android:focusableInTouchMode="true"
    android:orientation="vertical">

    <!-- ===== Toolbar: Cancel | Edit profile | Save =====
         The title takes the space between the two buttons (layout_weight 1) and centres in it. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/toolbar_height"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tv_cancel"
            style="@style/Kinnect.Text"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:background="?attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:paddingStart="@dimen/screen_margin"
            android:paddingEnd="@dimen/space_8"
            android:text="@string/edit_cancel"
            android:textSize="@dimen/text_name" />

        <!-- "Edit profile", or "Set up your profile" right after sign up -->
        <TextView
            android:id="@+id/tv_title"
            style="@style/Kinnect.Text.Title"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:ellipsize="end"
            android:gravity="center"
            android:singleLine="true"
            android:text="@string/edit_title" />

        <TextView
            android:id="@+id/tv_save"
            style="@style/Kinnect.Text.Link"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:background="?attr/selectableItemBackground"
            android:fontFamily="@font/figtree_bold"
            android:gravity="center_vertical"
            android:paddingStart="@dimen/space_8"
            android:paddingEnd="@dimen/screen_margin"
            android:text="@string/edit_save"
            android:textSize="@dimen/text_name" />
    </LinearLayout>

    <View style="@style/Kinnect.Divider" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="@dimen/space_16">

            <!-- ===== Profile picture: title + Edit, centred JW avatar ===== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/screen_margin"
                android:layout_marginTop="@dimen/edit_section_top"
                android:layout_marginEnd="@dimen/screen_margin"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <TextView
                    style="@style/Kinnect.Text.SectionTitle.Small"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:includeFontPadding="false"
                    android:text="@string/edit_profile_picture" />

                <!-- Edit: opens the Photo picker for one picture -->
                <TextView
                    android:id="@+id/tv_edit_photo"
                    style="@style/Kinnect.Text.Link"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/edit_link_top"
                    android:background="?attr/selectableItemBackground"
                    android:contentDescription="@string/cd_edit_profile_picture"
                    android:includeFontPadding="false"
                    android:text="@string/edit_link" />
            </LinearLayout>

            <!-- Avatar: coloured initials, with the profile picture on top when there is one
                 (Avatars.bind). Tapping it also opens the picker. -->
            <FrameLayout
                android:id="@+id/fl_avatar"
                android:layout_width="@dimen/avatar_103"
                android:layout_height="@dimen/avatar_103"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/edit_avatar_top"
                android:contentDescription="@string/cd_edit_profile_picture"
                android:foreground="?attr/selectableItemBackgroundBorderless">

                <TextView
                    android:id="@+id/tv_avatar"
                    style="@style/Kinnect.Avatar"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:importantForAccessibility="no"
                    android:textSize="@dimen/text_avatar_103" />

                <ImageView
                    android:id="@+id/iv_avatar_photo"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_avatar_circle"
                    android:importantForAccessibility="no"
                    android:scaleType="centerCrop"
                    android:visibility="gone" />
            </FrameLayout>

            <!-- ===== Cover photo: title + Edit, rounded wide photo with the camera badge ===== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/screen_margin"
                android:layout_marginTop="@dimen/edit_cover_title_top"
                android:layout_marginEnd="@dimen/screen_margin"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <TextView
                    style="@style/Kinnect.Text.SectionTitle.Small"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:includeFontPadding="false"
                    android:text="@string/edit_cover_photo" />

                <!-- Edit: opens the Photo picker for the cover -->
                <TextView
                    android:id="@+id/tv_edit_cover"
                    style="@style/Kinnect.Text.Link"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/edit_link_top"
                    android:background="?attr/selectableItemBackground"
                    android:contentDescription="@string/cd_edit_cover_photo"
                    android:includeFontPadding="false"
                    android:text="@string/edit_link" />
            </LinearLayout>

            <FrameLayout
                android:id="@+id/fl_cover"
                android:layout_width="match_parent"
                android:layout_height="@dimen/edit_cover_height"
                android:layout_marginStart="@dimen/screen_margin"
                android:layout_marginTop="@dimen/edit_cover_top"
                android:layout_marginEnd="@dimen/screen_margin"
                android:background="@drawable/bg_photo_rounded">

                <!-- The cover photo (centre-cropped to 3:1); the teal placeholder until one is chosen -->
                <ImageView
                    android:id="@+id/iv_cover"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:importantForAccessibility="no"
                    android:scaleType="centerCrop"
                    android:src="@drawable/ph_teal" />

                <!-- White camera circle: also opens the picker for the cover -->
                <ImageView
                    android:id="@+id/iv_cover_camera"
                    android:layout_width="@dimen/profile_cover_badge"
                    android:layout_height="@dimen/profile_cover_badge"
                    android:layout_gravity="bottom|end"
                    android:layout_margin="@dimen/edit_cover_badge_margin"
                    android:background="@drawable/bg_avatar_circle"
                    android:contentDescription="@string/cd_change_cover"
                    android:padding="@dimen/profile_badge_padding"
                    android:src="@drawable/ic_camera"
                    app:tint="@color/text_dark" />
            </FrameLayout>

            <View
                style="@style/Kinnect.Divider"
                android:layout_marginStart="@dimen/screen_margin"
                android:layout_marginTop="@dimen/edit_divider_top"
                android:layout_marginEnd="@dimen/screen_margin" />

            <!-- ===== Public details ===== -->
            <LinearLayout
                style="@style/Kinnect.EditRow"
                android:layout_marginTop="@dimen/edit_rows_top">

                <TextView
                    style="@style/Kinnect.EditRow.Label"
                    android:includeFontPadding="false"
                    android:labelFor="@id/et_name"
                    android:text="@string/edit_label_name" />

                <EditText
                    android:id="@+id/et_name"
                    style="@style/Kinnect.EditRow.Value"
                    android:importantForAutofill="no"
                    android:inputType="textPersonName|textCapWords" />
            </LinearLayout>

            <View style="@style/Kinnect.EditRow.Line" />

            <LinearLayout style="@style/Kinnect.EditRow">

                <TextView
                    style="@style/Kinnect.EditRow.Label"
                    android:includeFontPadding="false"
                    android:labelFor="@id/et_username"
                    android:text="@string/edit_label_username" />

                <!-- Small letters, numbers, dots and underscores; must be free (checked on Save) -->
                <EditText
                    android:id="@+id/et_username"
                    style="@style/Kinnect.EditRow.Value"
                    android:hint="@string/edit_hint_username"
                    android:importantForAutofill="no"
                    android:inputType="textNoSuggestions"
                    android:maxLength="20" />
            </LinearLayout>

            <View style="@style/Kinnect.EditRow.Line" />

            <LinearLayout style="@style/Kinnect.EditRow">

                <TextView
                    style="@style/Kinnect.EditRow.Label"
                    android:includeFontPadding="false"
                    android:labelFor="@id/et_website"
                    android:text="@string/edit_label_website" />

                <!-- Empty field: shows the grey hint "Website" -->
                <EditText
                    android:id="@+id/et_website"
                    style="@style/Kinnect.EditRow.Value"
                    android:hint="@string/edit_label_website"
                    android:importantForAutofill="no"
                    android:inputType="textUri" />
            </LinearLayout>

            <View style="@style/Kinnect.EditRow.Line" />

            <LinearLayout style="@style/Kinnect.EditRow">

                <TextView
                    style="@style/Kinnect.EditRow.Label"
                    android:includeFontPadding="false"
                    android:labelFor="@id/et_bio"
                    android:text="@string/edit_label_bio" />

                <EditText
                    android:id="@+id/et_bio"
                    style="@style/Kinnect.EditRow.Value"
                    android:hint="@string/edit_hint_bio"
                    android:importantForAutofill="no"
                    android:inputType="textCapSentences"
                    android:maxLength="101" />
            </LinearLayout>

            <View style="@style/Kinnect.EditRow.Line" />

            <!-- Assignment 2: the "Details" shown on Profile (15, 17) -->
            <LinearLayout style="@style/Kinnect.EditRow">

                <TextView
                    style="@style/Kinnect.EditRow.Label"
                    android:includeFontPadding="false"
                    android:labelFor="@id/et_work"
                    android:text="@string/edit_label_work" />

                <EditText
                    android:id="@+id/et_work"
                    style="@style/Kinnect.EditRow.Value"
                    android:hint="@string/edit_hint_work"
                    android:importantForAutofill="no"
                    android:inputType="textCapSentences" />
            </LinearLayout>

            <View style="@style/Kinnect.EditRow.Line" />

            <LinearLayout style="@style/Kinnect.EditRow">

                <TextView
                    style="@style/Kinnect.EditRow.Label"
                    android:includeFontPadding="false"
                    android:labelFor="@id/et_study"
                    android:text="@string/edit_label_study" />

                <EditText
                    android:id="@+id/et_study"
                    style="@style/Kinnect.EditRow.Value"
                    android:hint="@string/edit_hint_study"
                    android:importantForAutofill="no"
                    android:inputType="textCapWords" />
            </LinearLayout>

            <View style="@style/Kinnect.EditRow.Line" />

            <LinearLayout style="@style/Kinnect.EditRow">

                <TextView
                    style="@style/Kinnect.EditRow.Label"
                    android:includeFontPadding="false"
                    android:labelFor="@id/et_city"
                    android:text="@string/edit_label_city" />

                <EditText
                    android:id="@+id/et_city"
                    style="@style/Kinnect.EditRow.Value"
                    android:hint="@string/edit_hint_city"
                    android:importantForAutofill="no"
                    android:inputType="textCapWords" />
            </LinearLayout>

            <View style="@style/Kinnect.EditRow.Line" />

            <!-- Switch to professional mode: visual only -->
            <TextView
                style="@style/Kinnect.Text.Link"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/screen_margin"
                android:layout_marginTop="@dimen/edit_switch_top"
                android:fontFamily="@font/figtree_bold"
                android:includeFontPadding="false"
                android:text="@string/edit_switch_professional" />

            <!-- ===== Private information ===== -->
            <TextView
                style="@style/Kinnect.Text.SectionTitle.Small"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/screen_margin"
                android:layout_marginTop="@dimen/edit_private_top"
                android:includeFontPadding="false"
                android:text="@string/edit_private_information" />

            <LinearLayout
                style="@style/Kinnect.EditRow"
                android:layout_marginTop="@dimen/edit_private_rows_top">

                <TextView
                    style="@style/Kinnect.EditRow.Label"
                    android:includeFontPadding="false"
                    android:labelFor="@id/et_email"
                    android:text="@string/edit_label_email" />

                <!-- The login email: shown, not editable (it belongs to Firebase Authentication) -->
                <EditText
                    android:id="@+id/et_email"
                    style="@style/Kinnect.EditRow.Value"
                    android:enabled="false"
                    android:importantForAutofill="no"
                    android:inputType="textEmailAddress"
                    android:textColor="@color/text_grey" />
            </LinearLayout>

            <View style="@style/Kinnect.EditRow.Line" />

            <LinearLayout style="@style/Kinnect.EditRow">

                <TextView
                    style="@style/Kinnect.EditRow.Label"
                    android:includeFontPadding="false"
                    android:labelFor="@id/et_phone"
                    android:text="@string/edit_label_phone" />

                <EditText
                    android:id="@+id/et_phone"
                    style="@style/Kinnect.EditRow.Value"
                    android:importantForAutofill="no"
                    android:hint="@string/edit_hint_phone"
                    android:inputType="phone" />
            </LinearLayout>

            <View style="@style/Kinnect.EditRow.Line" />

            <!-- Gender is a fixed value here (not typed), so a plain TextView -->
            <LinearLayout style="@style/Kinnect.EditRow">

                <TextView
                    style="@style/Kinnect.EditRow.Label"
                    android:includeFontPadding="false"
                    android:text="@string/edit_label_gender" />

                <TextView
                    android:id="@+id/tv_gender"
                    style="@style/Kinnect.Text"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:letterSpacing="-0.01"
                    android:singleLine="true"
                    android:textSize="@dimen/text_name" />
            </LinearLayout>

            <View style="@style/Kinnect.EditRow.Line" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>