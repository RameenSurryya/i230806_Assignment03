<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <!-- ===== Pinned toolbar: back, "Chats", compose ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/toolbar_height"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/iv_back"
            style="@style/Kinnect.IconButton"
            android:contentDescription="@string/cd_back"
            android:src="@drawable/ic_back" />

        <TextView
            style="@style/Kinnect.Text.Heading"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:includeFontPadding="false"
            android:singleLine="true"
            android:text="@string/title_chats" />

        <!-- Compose: 36dp grey circle inside a 48dp touch frame. Opens Search to find someone. -->
        <FrameLayout
            android:id="@+id/fl_compose"
            android:layout_width="@dimen/touch_target"
            android:layout_height="@dimen/touch_target"
            android:layout_marginEnd="@dimen/chats_compose_end"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cd_new_message">

            <ImageView
                android:layout_width="@dimen/circle_button"
                android:layout_height="@dimen/circle_button"
                android:layout_gravity="center"
                android:background="@drawable/bg_circle_grey"
                android:importantForAccessibility="no"
                android:padding="@dimen/chats_compose_padding"
                android:src="@drawable/ic_edit"
                app:tint="@color/text_dark" />
        </FrameLayout>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="@dimen/space_16">

            <!-- ===== Search pill: filters the conversations below by name ===== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/input_height_search"
                android:layout_marginStart="@dimen/screen_margin"
                android:layout_marginTop="@dimen/chats_search_top"
                android:layout_marginEnd="@dimen/screen_margin"
                android:background="@drawable/bg_chip"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="@dimen/chats_search_padding"
                android:paddingEnd="@dimen/chats_search_padding">

                <ImageView
                    android:layout_width="@dimen/icon_size_small"
                    android:layout_height="@dimen/icon_size_small"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_search"
                    app:tint="@color/text_grey" />

                <EditText
                    android:id="@+id/et_search"
                    style="@style/Kinnect.Text"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="@dimen/chats_search_text_start"
                    android:layout_weight="1"
                    android:background="@null"
                    android:hint="@string/chats_search_hint"
                    android:imeOptions="actionSearch"
                    android:importantForAutofill="no"
                    android:includeFontPadding="false"
                    android:inputType="textPersonName"
                    android:singleLine="true"
                    android:textColorHint="@color/text_hint"
                    android:textSize="@dimen/text_name" />
            </LinearLayout>

            <!-- ===== Notes row: "Your note", then friends who are online. Scrolls sideways. ===== -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/chats_notes_top"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/chats_notes_start"
                    android:paddingEnd="@dimen/chats_notes_start">

                    <!-- Your note: grey circle with a plus -->
                    <LinearLayout style="@style/Kinnect.ChatNote">

                        <ImageView
                            android:layout_width="@dimen/avatar_52"
                            android:layout_height="@dimen/avatar_52"
                            android:background="@drawable/bg_circle_grey"
                            android:contentDescription="@string/cd_add_note"
                            android:padding="@dimen/chats_note_plus_padding"
                            android:src="@drawable/ic_plus"
                            app:tint="@color/text_dark" />

                        <TextView
                            style="@style/Kinnect.Text.ChatNote"
                            android:text="@string/chats_your_note"
                            android:textColor="@color/text_grey" />
                    </LinearLayout>

                    <!-- Friends who are online right now (item_chat_note.xml, added by ChatsActivity) -->
                    <LinearLayout
                        android:id="@+id/ll_notes"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal" />
                </LinearLayout>
            </HorizontalScrollView>

            <!-- ===== Conversations: one item_chat_row.xml per chat, newest first. Its own
                 scrolling is off, so the whole page scrolls as one. ===== -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_chats"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/chats_list_top" />

            <TextView
                android:id="@+id/tv_empty"
                style="@style/Kinnect.Text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/chats_empty_margin"
                android:gravity="center_horizontal"
                android:text="@string/chats_empty"
                android:textColor="@color/text_grey"
                android:visibility="gone" />
        </LinearLayout>
    </ScrollView>

    <!-- ===== Pinned bottom nav: Chats (active, teal), People (opens Friends), Stories (visual only) ===== -->
    <View style="@style/Kinnect.Divider" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/chats_nav_content"
        android:orientation="horizontal">

        <LinearLayout style="@style/Kinnect.NavItem">

            <ImageView
                style="@style/Kinnect.NavItem.Icon"
                android:src="@drawable/ic_messenger"
                app:tint="@color/teal" />

            <TextView
                style="@style/Kinnect.Text.NavLabel"
                android:text="@string/chats_nav_chats"
                android:textColor="@color/teal" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/ll_nav_people"
            style="@style/Kinnect.NavItem">

            <ImageView
                style="@style/Kinnect.NavItem.Icon"
                android:src="@drawable/ic_friends" />

            <TextView
                style="@style/Kinnect.Text.NavLabel"
                android:text="@string/chats_nav_people" />
        </LinearLayout>

        <LinearLayout style="@style/Kinnect.NavItem">

            <ImageView
                style="@style/Kinnect.NavItem.Icon"
                android:src="@drawable/ic_create_reel" />

            <TextView
                style="@style/Kinnect.Text.NavLabel"
                android:text="@string/chats_nav_stories" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>