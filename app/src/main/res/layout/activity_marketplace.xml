<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <!-- Pinned: "Marketplace" + small search / messenger circles -->
    <include
        layout="@layout/include_top_bar"
        android:theme="@style/ThemeOverlay.Kinnect.TopBarSmall" />

    <!-- Pinned: five tabs, Marketplace active -->
    <include layout="@layout/include_top_tabs" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_margin"
            android:paddingEnd="@dimen/screen_margin"
            android:paddingBottom="@dimen/space_16">

            <!-- ===== Sell (list an item) / Categories (visual only): two equal grey pills ===== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/market_chips_top"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/ll_sell"
                    style="@style/Kinnect.MarketPill">

                    <ImageView
                        style="@style/Kinnect.MarketPill.Icon"
                        android:src="@drawable/ic_edit" />

                    <TextView
                        style="@style/Kinnect.MarketPill.Label"
                        android:text="@string/market_sell" />
                </LinearLayout>

                <LinearLayout
                    style="@style/Kinnect.MarketPill"
                    android:layout_marginStart="@dimen/market_gap">

                    <ImageView
                        style="@style/Kinnect.MarketPill.Icon"
                        android:src="@drawable/ic_apps" />

                    <TextView
                        style="@style/Kinnect.MarketPill.Label"
                        android:text="@string/market_categories" />
                </LinearLayout>
            </LinearLayout>

            <!-- ===== "Today's picks" ...... pin "Karachi · 40 km" (baseline aligned) ===== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/market_title_top"
                android:orientation="horizontal">

                <TextView
                    style="@style/Kinnect.Text.SectionTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:includeFontPadding="false"
                    android:text="@string/market_todays_picks" />

                <!-- Pin + location. baselineAlignedChildIndex="1" lines the text (child 1)
                     up with the title's baseline; the pin is centred on the text. -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:baselineAlignedChildIndex="1"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="@dimen/icon_size_pin"
                        android:layout_height="@dimen/icon_size_pin"
                        android:layout_marginEnd="@dimen/market_pin_gap"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_pin"
                        app:tint="@color/teal" />

                    <TextView
                        style="@style/Kinnect.Text.Link"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/figtree_bold"
                        android:includeFontPadding="false"
                        android:text="@string/market_location"
                        android:textSize="@dimen/text_label" />
                </LinearLayout>
            </LinearLayout>

            <!-- ===== Products: two columns of item_listing.xml, newest first. Its own scrolling
                 is off, so the whole page scrolls as one. ===== -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_listings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/market_half_gap_negative"
                android:layout_marginTop="@dimen/market_grid_top"
                android:layout_marginEnd="@dimen/market_half_gap_negative" />

            <TextView
                android:id="@+id/tv_empty"
                style="@style/Kinnect.Text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/market_empty_margin"
                android:gravity="center_horizontal"
                android:text="@string/market_empty"
                android:textColor="@color/text_grey"
                android:visibility="gone" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>