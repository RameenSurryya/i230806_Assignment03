<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <!-- ===== 1. Pinned header ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/toolbar_height_chat"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/iv_back"
            style="@style/Kinnect.ChatHeaderIcon"
            android:layout_width="@dimen/touch_target"
            android:layout_marginStart="0dp"
            android:layout_marginEnd="0dp"
            android:paddingStart="@dimen/chat_header_icon_pad_v"
            android:paddingEnd="@dimen/chat_header_icon_pad_v"
            android:contentDescription="@string/cd_back"
            android:src="@drawable/ic_back" />

        <!-- Avatar + online dot, then name and status. Tap: their profile. -->
        <LinearLayout
            android:id="@+id/ll_header_person"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:layout_width="@dimen/avatar_36"
                android:layout_height="@dimen/avatar_36"
                android:layout_marginStart="@dimen/chat_avatar_start">

                <TextView
                    android:id="@+id/tv_header_avatar"
                    style="@style/Kinnect.Avatar"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <ImageView
                    android:id="@+id/iv_header_avatar_photo"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_avatar_circle"
                    android:importantForAccessibility="no"
                    android:scaleType="centerCrop"
                    android:visibility="gone" />

                <View
                    android:id="@+id/v_header_online"
                    style="@style/Kinnect.OnlineDot"
                    android:layout_width="@dimen/chat_online_dot"
                    android:layout_height="@dimen/chat_online_dot"
                    android:layout_marginEnd="0dp"
                    android:layout_marginBottom="0dp"
                    android:visibility="gone" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/chat_header_text_start"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_header_name"
                    style="@style/Kinnect.Text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="@font/bricolage_grotesque_bold"
                    android:includeFontPadding="false"
                    android:singleLine="true"
                    android:textSize="@dimen/text_chat_header_name" />

                <!-- "Active now" / "Active 5m ago"; hidden when unknown -->
                <TextView
                    android:id="@+id/tv_header_status"
                    style="@style/Kinnect.Text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/chat_status_top"
                    android:includeFontPadding="false"
                    android:singleLine="true"
                    android:textColor="@color/text_grey"
                    android:textSize="@dimen/text_chat_status"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>

        <ImageView
            android:id="@+id/iv_call"
            style="@style/Kinnect.ChatHeaderIcon"
            android:contentDescription="@string/cd_voice_call"
            android:src="@drawable/ic_phone" />

        <ImageView
            android:id="@+id/iv_video"
            style="@style/Kinnect.ChatHeaderIcon"
            android:contentDescription="@string/cd_video_call"
            android:src="@drawable/ic_video" />

        <ImageView
            android:id="@+id/iv_info"
            style="@style/Kinnect.ChatHeaderIcon"
            android:layout_marginEnd="@dimen/chat_header_end"
            android:contentDescription="@string/cd_chat_info"
            android:src="@drawable/ic_info" />
    </LinearLayout>

    <View style="@style/Kinnect.Divider" />

    <!-- ===== 2. Messages: intro (item_chat_intro.xml) then one item_message.xml per message.
         Starts at the bottom like every chat app (stackFromEnd in ChatActivity). ===== -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_messages"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingStart="@dimen/chat_margin_start"
        android:paddingEnd="@dimen/chat_margin_end"
        android:paddingBottom="@dimen/chat_typing_top"
        android:scrollbars="none" />

    <!-- "is typing": avatar + grey bubble with three dots, just above the input bar -->
    <LinearLayout
        android:id="@+id/ll_typing"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/chat_typing_top"
        android:gravity="bottom"
        android:orientation="horizontal"
        android:paddingStart="@dimen/chat_margin_start"
        android:visibility="gone">

        <FrameLayout
            android:layout_width="@dimen/avatar_26"
            android:layout_height="@dimen/avatar_26">

            <TextView
                android:id="@+id/tv_typing_avatar"
                style="@style/Kinnect.Avatar"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:textSize="@dimen/text_avatar_26" />

            <ImageView
                android:id="@+id/iv_typing_avatar_photo"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_avatar_circle"
                android:importantForAccessibility="no"
                android:scaleType="centerCrop"
                android:visibility="gone" />
        </FrameLayout>

        <LinearLayout
            android:id="@+id/ll_typing_bubble"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/chat_typing_height"
            android:layout_marginStart="@dimen/chat_avatar_gap"
            android:background="@drawable/bg_bubble_received"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/chat_typing_pad"
            android:paddingEnd="@dimen/chat_typing_pad">

            <View
                style="@style/Kinnect.TypingDot"
                android:backgroundTint="@color/typing_dot_1" />

            <View
                style="@style/Kinnect.TypingDot"
                android:layout_marginStart="@dimen/chat_typing_dot_gap"
                android:backgroundTint="@color/typing_dot_2" />

            <View
                style="@style/Kinnect.TypingDot"
                android:layout_marginStart="@dimen/chat_typing_dot_gap"
                android:backgroundTint="@color/typing_dot_3" />
        </LinearLayout>
    </LinearLayout>

    <!-- "Replying to Aisha" + the message being answered, with an X to cancel -->
    <LinearLayout
        android:id="@+id/ll_reply_bar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/chat_reply_bar_height"
        android:background="@color/chip_fill"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/screen_margin"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_reply_to"
                style="@style/Kinnect.Text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/figtree_semibold"
                android:includeFontPadding="false"
                android:singleLine="true"
                android:textSize="@dimen/text_chat_message" />

            <TextView
                android:id="@+id/tv_reply_text"
                style="@style/Kinnect.Text.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/chat_status_top"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:singleLine="true" />
        </LinearLayout>

        <ImageView
            android:id="@+id/iv_cancel_reply"
            android:layout_width="@dimen/touch_target"
            android:layout_height="@dimen/touch_target"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cd_cancel_reply_chat"
            android:padding="@dimen/chat_header_icon_pad_v"
            android:src="@drawable/ic_close"
            app:tint="@color/text_grey" />
    </LinearLayout>

    <!-- ===== 3. Pinned input bar ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/chat_bar_start"
        android:paddingTop="@dimen/chat_bar_top"
        android:paddingEnd="@dimen/chat_bar_end"
        android:paddingBottom="@dimen/chat_bar_bottom">

        <!-- Plus and mic: visual only -->
        <ImageView
            style="@style/Kinnect.ChatBarIcon"
            android:contentDescription="@string/cd_more_actions"
            android:paddingStart="@dimen/chat_bar_plus_pad_h"
            android:paddingTop="@dimen/chat_bar_plus_pad_v"
            android:paddingEnd="@dimen/chat_bar_plus_pad_h"
            android:paddingBottom="@dimen/chat_bar_plus_pad_v"
            android:src="@drawable/ic_plus_circle" />

        <!-- Camera: take a photo and send it -->
        <ImageView
            android:id="@+id/iv_camera"
            style="@style/Kinnect.ChatBarIcon"
            android:contentDescription="@string/cd_camera"
            android:src="@drawable/ic_camera" />

        <!-- Gallery: pick a photo and send it -->
        <ImageView
            android:id="@+id/iv_gallery"
            style="@style/Kinnect.ChatBarIcon"
            android:contentDescription="@string/cd_gallery"
            android:src="@drawable/ic_image" />

        <ImageView
            style="@style/Kinnect.ChatBarIcon"
            android:contentDescription="@string/cd_voice_clip"
            android:src="@drawable/ic_mic" />

        <!-- "Aa" field with the emoji icon inside at the right -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="@dimen/input_height_search"
            android:layout_marginStart="@dimen/chat_field_start"
            android:layout_weight="1"
            android:background="@drawable/bg_chip"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/input_padding"
            android:paddingEnd="@dimen/chat_field_icon_end">

            <EditText
                android:id="@+id/et_message"
                style="@style/Kinnect.Text"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@null"
                android:hint="@string/chat_hint"
                android:importantForAutofill="no"
                android:includeFontPadding="false"
                android:inputType="textCapSentences|textMultiLine"
                android:maxLines="3"
                android:textColorHint="@color/text_hint"
                android:textSize="@dimen/text_name" />

            <ImageView
                android:layout_width="@dimen/icon_size_chat"
                android:layout_height="@dimen/icon_size_chat"
                android:contentDescription="@string/cd_emoji"
                android:src="@drawable/ic_smile"
                app:tint="@color/teal" />
        </LinearLayout>

        <!-- Thumbs-up (sends a like) while the field is empty, paper plane (send) after typing -->
        <ImageView
            android:id="@+id/iv_send"
            style="@style/Kinnect.ChatBarIcon"
            android:layout_width="@dimen/chat_like_width"
            android:contentDescription="@string/cd_send_like"
            android:paddingStart="@dimen/chat_like_pad_h"
            android:paddingTop="@dimen/chat_like_pad_v"
            android:paddingEnd="@dimen/chat_like_pad_h"
            android:paddingBottom="@dimen/chat_like_pad_v"
            android:src="@drawable/ic_like" />
    </LinearLayout>
</LinearLayout>