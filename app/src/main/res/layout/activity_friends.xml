<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <!-- Pinned: "Friends" + small search / messenger circles -->
    <include
        layout="@layout/include_top_bar"
        android:theme="@style/ThemeOverlay.Kinnect.TopBarSmall" />

    <!-- Pinned: five tabs, Friends active -->
    <include layout="@layout/include_top_tabs" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="@dimen/space_16">

            <!-- ===== Chips: Suggestions (requests + people you may know) | Your friends.
                 FriendsActivity switches between the two sections and colours the chosen chip. ===== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/screen_margin"
                android:layout_marginTop="@dimen/friends_chips_top"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_chip_suggestions"
                    style="@style/Kinnect.Chip"
                    android:text="@string/friends_suggestions" />

                <TextView
                    android:id="@+id/tv_chip_friends"
                    style="@style/Kinnect.Chip"
                    android:layout_marginStart="@dimen/chip_gap"
                    android:text="@string/friends_your_friends" />
            </LinearLayout>

            <!-- ======================= Suggestions section ======================= -->
            <LinearLayout
                android:id="@+id/ll_suggestions_section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- "Friend requests 12" (the count is orange) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/friends_title_top"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/screen_margin"
                    android:paddingEnd="@dimen/screen_margin">

                    <TextView
                        style="@style/Kinnect.Text.SectionTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:includeFontPadding="false"
                        android:text="@string/friends_requests" />

                    <!-- The count is a second TextView so it can be orange -->
                    <TextView
                        android:id="@+id/tv_request_count"
                        style="@style/Kinnect.Text.SectionTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/friends_count_gap"
                        android:layout_weight="1"
                        android:includeFontPadding="false"
                        android:textColor="@color/accent_orange" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tv_no_requests"
                    style="@style/Kinnect.Text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/screen_margin"
                    android:layout_marginTop="@dimen/space_8"
                    android:layout_marginEnd="@dimen/screen_margin"
                    android:text="@string/friends_no_requests"
                    android:textColor="@color/text_grey"
                    android:visibility="gone" />

                <!-- One card per request (item_friend_card.xml): Confirm / Delete -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_requests"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/friends_rows_top" />

                <!-- Divider + "People you may know" -->
                <View
                    style="@style/Kinnect.Divider"
                    android:layout_marginStart="@dimen/screen_margin"
                    android:layout_marginTop="@dimen/friends_divider_top"
                    android:layout_marginEnd="@dimen/screen_margin" />

                <TextView
                    style="@style/Kinnect.Text.SectionTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/screen_margin"
                    android:layout_marginTop="@dimen/friends_more_top"
                    android:includeFontPadding="false"
                    android:text="@string/friends_people_you_may_know" />

                <TextView
                    android:id="@+id/tv_no_suggestions"
                    style="@style/Kinnect.Text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/screen_margin"
                    android:layout_marginTop="@dimen/space_8"
                    android:layout_marginEnd="@dimen/screen_margin"
                    android:text="@string/friends_no_suggestions"
                    android:textColor="@color/text_grey"
                    android:visibility="gone" />

                <!-- Same cards with Add friend / Remove -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_suggestions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/friends_rows_top" />
            </LinearLayout>

            <!-- ======================= Your friends section ======================= -->
            <LinearLayout
                android:id="@+id/ll_friends_section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/friends_title_top"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/screen_margin"
                    android:paddingEnd="@dimen/screen_margin">

                    <TextView
                        style="@style/Kinnect.Text.SectionTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:includeFontPadding="false"
                        android:text="@string/friends_your_friends" />

                    <TextView
                        android:id="@+id/tv_friend_count"
                        style="@style/Kinnect.Text.SectionTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/friends_count_gap"
                        android:layout_weight="1"
                        android:includeFontPadding="false"
                        android:textColor="@color/accent_orange" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tv_no_friends"
                    style="@style/Kinnect.Text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/screen_margin"
                    android:layout_marginTop="@dimen/space_8"
                    android:layout_marginEnd="@dimen/screen_margin"
                    android:text="@string/friends_no_friends"
                    android:textColor="@color/text_grey"
                    android:visibility="gone" />

                <!-- One row per friend (item_search_person.xml, without the add button) -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_friends"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/search_rows_top" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>