<?xml version="1.0" encoding="utf-8"?>

<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/fl_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen_dimmed"
    android:clipChildren="false"
    android:fitsSystemWindows="true">

    <!-- ===== Layer 1: the post screen underneath ("Lina's post") ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/background"
        android:orientation="vertical">

        <!-- Toolbar: back arrow and "<name>'s post" -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/toolbar_height"
            android:background="@color/surface"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/iv_back"
                style="@style/Kinnect.IconButton"
                android:contentDescription="@string/cd_back"
                android:src="@drawable/ic_back" />

            <TextView
                android:id="@+id/tv_title"
                style="@style/Kinnect.Text.Title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:singleLine="true" />
        </LinearLayout>

        <!-- The real post, the same card as on Home (item_post.xml), filled by PostViews -->
        <ScrollView
            android:id="@+id/sv_post"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:scrollbars="none">

            <include
                android:id="@+id/post"
                layout="@layout/item_post" />
        </ScrollView>
    </LinearLayout>

    <!-- ===== Layer 2: dim over the whole post screen; tapping it closes the picker ===== -->
    <View
        android:id="@+id/v_dim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_overlay_dim"
        android:contentDescription="@string/cd_close_reactions" />

    <!-- ===== Layer 3: tooltip and reaction pill, not dimmed. ReactionPickerActivity moves
         them just above the post's Like button once the post has been laid out. ===== -->

    <!-- Name of the raised reaction ("Love") -->
    <TextView
        android:id="@+id/tv_tooltip"
        style="@style/Kinnect.Text"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/tooltip_height"
        android:layout_marginStart="@dimen/tooltip_start"
        android:layout_marginTop="@dimen/tooltip_top"
        android:background="@drawable/bg_tooltip"
        android:fontFamily="@font/figtree_bold"
        android:gravity="center"
        android:includeFontPadding="false"
        android:paddingStart="@dimen/tooltip_padding"
        android:paddingEnd="@dimen/tooltip_padding"
        android:text="@string/reaction_love"
        android:textColor="@color/white"
        android:textSize="@dimen/text_tooltip" />

    <!-- White pill with the six reactions. The raised one (your current reaction, or Love
         when you haven't reacted) is enlarged and lifted by ReactionPickerActivity. -->
    <LinearLayout
        android:id="@+id/ll_reactions"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/reaction_tray_height"
        android:layout_marginStart="@dimen/reaction_tray_start"
        android:layout_marginTop="@dimen/reaction_tray_top"
        android:background="@drawable/bg_reaction_tray"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:elevation="@dimen/reaction_tray_elevation"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/reaction_tray_padding"
        android:paddingEnd="@dimen/reaction_tray_padding">

        <ImageView
            android:id="@+id/iv_reaction_like"
            style="@style/Kinnect.Reaction"
            android:contentDescription="@string/reaction_like"
            android:src="@drawable/reaction_like" />

        <ImageView
            android:id="@+id/iv_reaction_love"
            style="@style/Kinnect.Reaction"
            android:contentDescription="@string/reaction_love"
            android:src="@drawable/reaction_love" />

        <ImageView
            android:id="@+id/iv_reaction_haha"
            style="@style/Kinnect.Reaction"
            android:contentDescription="@string/reaction_haha"
            android:src="@drawable/reaction_haha" />

        <ImageView
            android:id="@+id/iv_reaction_wow"
            style="@style/Kinnect.Reaction"
            android:contentDescription="@string/reaction_wow"
            android:src="@drawable/reaction_wow" />

        <ImageView
            android:id="@+id/iv_reaction_sad"
            style="@style/Kinnect.Reaction"
            android:contentDescription="@string/reaction_sad"
            android:src="@drawable/reaction_sad" />

        <ImageView
            android:id="@+id/iv_reaction_angry"
            style="@style/Kinnect.Reaction"
            android:contentDescription="@string/reaction_angry"
            android:src="@drawable/reaction_angry" />
    </LinearLayout>
</FrameLayout>