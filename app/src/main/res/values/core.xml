<?xml version="1.0" encoding="utf-8"?>
<!--
    Assignment 2: resources shared by the whole app (KinnectApp, Times, Images, BaseActivity).
    Each later step adds its own values file (strings_auth.xml, strings_chat.xml ...) instead of
    editing strings.xml, so no file has to be pasted twice. Android merges every file in values/.
-->
<resources>

    <!-- Notification channels (KinnectApp), shown in the phone's app settings -->
    <string name="channel_messages">Messages</string>
    <string name="channel_calls">Calls</string>
    <string name="channel_general">Activity</string>

    <!-- Relative times (Times.kt): "now", "5m", "2h", "Yesterday", "3d", "2w" -->
    <string name="time_now">now</string>
    <string name="time_minutes">%1$dm</string>
    <string name="time_hours">%1$dh</string>
    <string name="time_days">%1$dd</string>
    <string name="time_weeks">%1$dw</string>
    <string name="time_yesterday">Yesterday</string>
    <string name="time_today_caps">TODAY</string>
    <string name="time_yesterday_caps">YESTERDAY</string>
    <string name="joined_format">Joined %1$s</string>

    <!-- Messages shown in a Toast when something fails -->
    <string name="error_generic">Something went wrong. Please try again.</string>
    <string name="error_network">Check your internet connection and try again.</string>

    <!-- Badge when there are more than nine -->
    <string name="badge_many" translatable="false">9+</string>

    <!-- View tag: which media id an ImageView is showing (Images.load) -->
    <item name="tag_media_id" type="id" />
</resources>